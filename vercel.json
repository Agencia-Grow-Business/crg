{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm install && npm run build && rm -rf dist && mkdir -p dist && cp -a public/build dist/build && cp -a public/images dist/images && cp public/favicon.ico public/robots.txt dist/",
    "outputDirectory": "dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "rewrites": [
        { "source": "/(.*)", "destination": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp/laravel/framework/views"
    }
}
